meta_df <- obj@meta.data


# 2. mean MP
mp_patient_mean <- meta_df %>%
  group_by(patients) %>%
  summarise(
    MP1_score_mean = mean(MP1_score, na.rm = TRUE),
    MP2_score_mean = mean(MP2_score, na.rm = TRUE),
    MP3_score_mean = mean(MP3_score, na.rm = TRUE),
    MP4_score_mean = mean(MP4_score, na.rm = TRUE),
    n_cells = n()
  ) %>%
  ungroup()

# 3. result
print(mp_patient_mean)

